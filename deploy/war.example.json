{
  "IMAGE": "node:24-alpine",
  "VCS_DATA": {
    "PROVIDER": "github",
    "REPO_URL": "https://github.com/aidamian/andreidamian",
    "BRANCH": "main",
    "TOKEN": "<retain-existing-website-repository-token>"
  },
  "BUILD_AND_RUN_COMMANDS": [
    "npm ci --omit=dev",
    "npm start"
  ],
  "ENV": {
    "NODE_ENV": "production",
    "PORT": "8080",
    "GITHUB_TOKEN": "<inject-read-only-github-statistics-token>"
  },
  "CONTAINER_RESOURCES": {
    "cpu": 0.25,
    "gpu": 0,
    "memory": "512m",
    "storage": "2g"
  },
  "TUNNEL_ENGINE_ENABLED": true,
  "EXPOSED_PORTS": {
    "8080": {
      "is_main_port": true,
      "engine": "cloudflare",
      "protocol": "http",
      "token": "<retain-existing-cloudflare-tunnel-token>"
    }
  },
  "HEALTH_CHECK": {
    "MODE": "endpoint",
    "PATH": "/healthz",
    "TIMEOUT": 300,
    "ON_FAILURE": "skip"
  }
}
