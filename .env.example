# Optional local settings: copy to .env; npm start loads it if present.
PORT=8080
DATA_DIR=.data

# Read-only GitHub API credential for the public PurpleRay release statistics.
# Leave blank for local unauthenticated use, subject to GitHub's shared IP limit.
GITHUB_TOKEN=

# WAR supplies node identity automatically. Do not set R1EN_HOST_ID/ADDR here.
# WAR production must mount its persistent stats volume and set DATA_DIR=/data.
# VCS_DATA.TOKEN and the Cloudflare tunnel token belong in the WAR configuration.
